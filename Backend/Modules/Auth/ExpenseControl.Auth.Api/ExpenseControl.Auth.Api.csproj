<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bb68fcb5-e410-4a79-be76-5dc86578699c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\Shared\ExpenseControl.Shared\Grpc\Auth.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\ExpenseControl.Shared\ExpenseControl.Shared.csproj" />
    <ProjectReference Include="..\ExpenseControl.Auth.Application\ExpenseControl.Auth.Application.csproj" />
    <ProjectReference Include="..\ExpenseControl.Auth.Infrastructure\ExpenseControl.Auth.Infrastructure.csproj" />
  </ItemGroup>

</Project>
